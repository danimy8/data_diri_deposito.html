<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulir Data Diri & Tanda Tangan Digital</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Print styles optimized for PDF generation */
        @media print {
            body {
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .shadow-custom {
                box-shadow: none !important;
            }
            .print-container {
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .print-card {
                border: 1px solid #e2e8f0 !important;
                break-inside: avoid;
            }
        }

        .canvas-container {
            touch-action: none;
        }

        .custom-glass {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }

        /* Header & footer khusus cetak: sembunyi di layar */
        .print-header, .print-footer { display: none; }

        @media print {
            @page { margin: 10mm; }

            .print-header { display: block !important; margin-bottom: 16px; }
            .print-footer { display: block !important; margin-top: 24px; }

            .print-banner {
                display: block;
                width: 100%;
                height: auto;
            }
        }
                /* ===== CETAK 1 LEMBAR A4 ===== */
        @media print {
            @page { size: A4 portrait; margin: 8mm; }

            html, body { height: auto !important; }
            body { padding: 0 !important; background: white !important; }
            .print-container { max-width: none !important; }
            .print-card, .print-card * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            /* Kartu tanpa bingkai dan padding */
            .print-card {
                padding: 0 !important;
                border: none !important;
                box-shadow: none !important;
                border-radius: 0 !important;
            }
            .print-header { margin-bottom: 8px !important; }
            .print-footer { margin-top: 8px !important; }

            /* Judul kartu */
            .print-card > .border-b { padding-bottom: 4px !important; margin-bottom: 8px !important; gap: 4px !important; }
            .print-card h2 { font-size: 15px !important; margin-top: 2px !important; }
            .print-card h3 { font-size: 9px !important; margin: 0 0 3px 0 !important; }

            /* Foto di kiri, data di kanan */
            .print-card > .grid { grid-template-columns: 105px minmax(0, 1fr) !important; gap: 10px !important; }
            .print-card .md\:col-span-1,
            .print-card .md\:col-span-3 { grid-column: auto !important; }
            .print-card > .grid > div:first-child > div { width: 95px !important; height: 125px !important; }

            /* Data jadi 3 kolom */
            .print-card .md\:col-span-3 > .grid {
                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                grid-auto-flow: dense;
                gap: 4px !important;
            }
            .print-card .md\:col-span-3 > .grid > div:not([class]) { grid-column: 1 / -1; }
            .print-card div:not([class]) > .grid {
                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                gap: 4px !important;
            }
            .print-card .sm\:col-span-2 { grid-column: span 1 !important; }
            .print-card div:has(> #reviewAddress),
            .print-card div:has(> #reviewJobAddress) { grid-column: span 2 !important; }

            /* Blok Pembukaan Rekening Tabungan */
            .print-card > .mt-8 { margin-top: 8px !important; }
            .print-card > .mt-8 > .grid {
                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                gap: 4px !important;
            }

            /* Kotak data lebih kecil */
            .print-card .md\:col-span-3 .bg-slate-50,
            .print-card > .mt-8 .bg-slate-50 {
                padding: 4px 7px !important;
                border-radius: 6px !important;
            }
            .print-card .bg-slate-50 > span:first-child { font-size: 7px !important; line-height: 9px !important; }
            .print-card .bg-slate-50 > span:last-child  { font-size: 9.5px !important; line-height: 12px !important; }

            /* Pernyataan dan tanda tangan */
            .print-card > .mt-10 {
                margin-top: 8px !important;
                padding-top: 6px !important;
                flex-direction: row !important;
                gap: 12px !important;
            }
            .print-card > .mt-10 > div:first-child {
                font-size: 8px !important;
                line-height: 1.35 !important;
                max-width: none !important;
                flex: 1;
            }
            .print-card > .mt-10 span { font-size: 8px !important; }
            .print-card > .mt-10 > div:last-child > div { width: 150px !important; height: 60px !important; }
            .print-card { zoom: 0.9; }
            }
        
            /* ===== TANDA TANGAN PIHAK BANK ===== */
            .bank-sign { break-inside: avoid; }
            @media print {
            .bank-sign { margin-top: 8px !important; gap: 6px !important; }
            .bank-sign > div { padding: 4px 6px !important; border-color: #94a3b8 !important; }
            .bank-sign-title { font-size: 8.5px !important; line-height: 11px !important; min-height: 22px !important; }
            .bank-sign-space { height: 42px !important; }
            .bank-sign-note  { font-size: 7.5px !important; }
            }
        
            /* ===== TATA LETAK TANDA TANGAN: pihak bank di samping pemohon ===== */
            .sign-section { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid #e2e8f0; }
            .sign-row { display: flex; flex-direction: column; align-items: flex-end; gap: 16px; margin-top: 16px; }
            .sign-row .bank-sign { flex: 1 1 0; min-width: 0; margin-top: 0; }
            .applicant-sign { margin-left: auto; }
            @media (min-width: 640px) { .sign-row { flex-direction: row; } }

            @media print {
                .sign-section { margin-top: 8px !important; padding-top: 6px !important; break-inside: avoid; }
                .sign-section .stmt-box { font-size: 8px !important; line-height: 1.35 !important; max-width: none !important; }
                .sign-row { flex-direction: row !important; align-items: flex-end !important; gap: 10px !important; margin-top: 6px !important; }
                .sign-row .bank-sign { margin-top: 0 !important; }
                .applicant-sign span { font-size: 8px !important; }
                .applicant-sign > div { width: 140px !important; height: 56px !important; }
            }

            /* ===== DEPOSITO: lebar kolom khusus cetak ===== */
            @media print {
                .print-card > .mt-8 .col-wide { grid-column: span 2 !important; }
                .print-card > .mt-8 .col-full { grid-column: 1 / -1 !important; }
            }
    </style>
</head>
<body class="min-h-screen text-slate-800 antialiased py-8 px-4 sm:px-6 lg:px-8">

    <div class="max-w-4xl mx-auto print-container">
        <!-- Header -->
        <header class="text-center mb-8 no-print">
            <div class="inline-flex items-center justify-center p-3 bg-brand-500 text-white rounded-2xl shadow-lg mb-4">
                <i class="fa-solid fa-address-card text-3xl"></i>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Formulir Data Diri Nasabah</h1>
            <p class="mt-2 text-slate-600">Lengkapi data diri, Foto KTP, dan Tangan Tangan Anda di bawah ini dengan benar ya.</p>
        </header>

        <!-- FORM SECTION -->
        <div id="formSection" class="bg-white rounded-2xl shadow-xl border border-slate-100 p-6 sm:p-10 transition-all duration-300">
            <form id="bioForm" onsubmit="handleFormSubmit(event)" class="space-y-8">
                
                <!-- PasFoto Section -->
                <div>
                    <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-camera text-brand-600"></i> Foto KTP / Pasfoto KTP
                    </h2>
                    <div class="flex flex-col sm:flex-row items-center gap-6 p-4 bg-slate-50 rounded-xl border border-dashed border-slate-300">
                        <div class="relative w-32 h-40 bg-slate-200 rounded-lg overflow-hidden flex items-center justify-center border border-slate-300 shadow-inner group">
                            <img id="photoPreview" src="" alt="Preview Foto" class="w-full h-full object-cover hidden">
                            <div id="photoPlaceholder" class="text-center p-4">
                                <i class="fa-solid fa-user text-4xl text-slate-400 mb-1"></i>
                                <span class="block text-xs text-slate-500 font-medium">Foto KTP</span>
                            </div>
                        </div>
                        <div class="flex-1 space-y-2 text-center sm:text-left">
                            <label for="photoInput" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer shadow-sm transition-colors">
                                <i class="fa-solid fa-upload text-brand-600"></i> Pilih Foto
                            </label>
                            <input type="file" id="photoInput" accept="image/*" class="hidden" onchange="previewImage(event)" required>
                            <p class="text-xs text-slate-500">Gunakan format JPG, PNG, atau WEBP. Ukuran file disarankan di bawah 2MB.</p>
                            <button type="button" id="removePhotoBtn" onclick="removePhoto()" class="hidden text-xs text-red-600 hover:underline font-medium">Hapus Foto</button>
                        </div>
                    </div>
                </div>

                <!-- Personal Information -->
                <div>
                    <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-user-pen text-brand-600"></i> Data Pribadi
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap <span class="text-red-500">*</span></label>
                            <input type="text" id="fullName" required placeholder="Contoh: Budi Pratama, S.Kom" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Alias <span class="text-red-500">*</span></label>
                            <input type="text" id="alias" placeholder="Contoh: Budi Pratama, S.Kom" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Nomor Induk Kependudukan (NIK) <span class="text-red-500">*</span></label>
                            <input type="text" id="nik" required inputmode="numeric" maxlength="16" pattern="[0-9]{16}" oninput="onlyDigits(this)" placeholder="16 digit angka" title="NIK harus 16 digit angka" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">                        </div>
                        
                         <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Kewarganegaraan <span class="text-red-500">*</span></label>
                            <select id="citizenship" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Pilih Kewarganegaraan --</option>
                                <option value="WNI">WNI (Warga Negara Indonesia)</option>
                                <option value="WNA">WNA (Warga Negara Asing)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Nomor NPWP</label>
                            <input type="text" id="npwp" placeholder="15 atau 16 digit (boleh dengan titik/strip)" pattern="[0-9.\-]{15,24}" title="Masukkan 15 atau 16 digit NPWP" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>


                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Tempat Lahir <span class="text-red-500">*</span></label>
                            <input type="text" id="birthPlace" required placeholder="Contoh: Jakarta" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Tanggal Lahir <span class="text-red-500">*</span></label>
                            <input type="date" id="birthDate" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Jenis Kelamin <span class="text-red-500">*</span></label>
                            <select id="gender" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Pilih Jenis Kelamin --</option>
                                <option value="Laki-laki">Laki-laki</option>
                                <option value="Perempuan">Perempuan</option>
                            </select>
                        </div>

                           <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Pernikahan <span class="text-red-500">*</span></label>
                            <select id="maritalStatus" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Status Pernikahan --</option>
                                <option value="Menikah">Menikah</option>
                                <option value="Belum Menikah">Belum Menikah</option>
                                <option value="Janda">Janda</option>
                                <option value="Duda">Duda</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Agama <span class="text-red-500">*</span></label>
                            <select id="religion" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Pilih Agama --</option>
                                <option value="Islam">Islam</option>
                                <option value="Kristen Protestan">Kristen Protestan</option>
                                <option value="Katolik">Katolik</option>
                                <option value="Hindu">Hindu</option>
                                <option value="Buddha">Buddha</option>
                                <option value="Khonghucu">Khonghucu</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Pekerjaan / Bidang Usaha <span class="text-red-500">*</span></label>
                            <input type="text" id="job" required placeholder="Contoh: Wiraswasta" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Alamat Pekerjaan <span class="text-red-500">*</span></label>
                            <textarea id="jobAddress" rows="3" required placeholder="Nama perusahaan/instansi, jalan, kota, provinsi" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Pendidikan Terakhir <span class="text-red-500">*</span></label>
                            <select id="education" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Pilih Pendidikan --</option>
                                <option value="SD">SD</option>
                                <option value="SMP">SMP</option>
                                <option value="SMA/SMK">SMA/SMK</option>
                                <option value="D1/D2/D3">D1/D2/D3</option>
                                <option value="D4/S1">D4/S1</option>
                                <option value="S2">S2</option>
                                <option value="S3">S3</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Penghasilan per Bulan <span class="text-red-500">*</span></label>
                            <select id="income" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Pilih Rentang Penghasilan --</option>
                                <option value="< Rp 5.000.000">&lt; Rp 5.000.000</option>
                                <option value="Rp 5.000.000 - Rp 10.000.000">Rp 5.000.000 - Rp 10.000.000</option>
                                <option value="Rp 10.000.000 - Rp 25.000.000">Rp 10.000.000 - Rp 25.000.000</option>
                                <option value="Rp 25.000.000 - Rp 50.000.000">Rp 25.000.000 - Rp 50.000.000</option>
                                <option value="> Rp 50.000.000">&gt; Rp 50.000.000</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Volume / Omset per Bulan</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm font-medium">Rp</span>
                                <input type="text" id="turnover" inputmode="numeric" placeholder="0 (khusus wiraswasta/usaha)" oninput="formatRupiah(this)" class="w-full pl-11 pr-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Tujuan Pembukaan Rekening <span class="text-red-500">*</span></label>
                            <select id="accountPurpose" required onchange="toggleOther('accountPurpose','accountPurposeOther')" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Pilih Tujuan --</option>
                                <option value="Tabungan">Tabungan</option>
                                <option value="Investasi">Investasi</option>
                                <option value="Transaksi Usaha">Transaksi Usaha</option>
                                <option value="Pembayaran Gaji">Pembayaran Gaji</option>
                                <option value="Pendidikan">Pendidikan</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                            <input type="text" id="accountPurposeOther" placeholder="Sebutkan tujuan lainnya" class="hidden mt-2 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Asal Sumber Dana <span class="text-red-500">*</span></label>
                            <select id="fundSource" required onchange="toggleOther('fundSource','fundSourceOther')" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white">
                                <option value="">-- Pilih Sumber Dana --</option>
                                <option value="Gaji">Gaji</option>
                                <option value="Hasil Usaha">Hasil Usaha</option>
                                <option value="Warisan">Warisan</option>
                                <option value="Hibah / Hadiah">Hibah / Hadiah</option>
                                <option value="Tabungan / Deposito">Tabungan / Deposito</option>
                                <option value="Penjualan Aset">Penjualan Aset</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                            <input type="text" id="fundSourceOther" placeholder="Sebutkan sumber dana lainnya" class="hidden mt-2 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Nama Ibu Kandung <span class="text-red-500">*</span></label>
                            <input type="text" id="motherName" required placeholder="Nama lengkap ibu kandung" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Nama Suami / Istri</label>
                            <input type="text" id="spouseName" placeholder="Kosongkan jika belum menikah" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">
                        </div>

                        
                    </div>
                </div>

                <!-- Contact & Additional Details -->
                <div>
                    <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-envelope text-brand-600"></i> Kontak & Alamat
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Nomor Telepon / WhatsApp <span class="text-red-500">*</span></label>
                            <input type="tel" id="phone" required inputmode="numeric" maxlength="13" pattern="[0-9]{10,13}" oninput="onlyDigits(this)" placeholder="081234567890" title="Nomor telepon 10 sampai 13 digit angka" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all">                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Alamat Lengkap <span class="text-red-500">*</span></label>
                            <textarea id="address" rows="3" required placeholder="Nama Jalan, RT/RW, Kelurahan, Kecamatan, Kota/Kabupaten, Provinsi" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"></textarea>
                        </div>
                    </div>
                </div>
                <!-- Perwalian / Ahli Waris -->
                <div>
                    <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-people-roof text-brand-600"></i> Perwalian / Ahli Waris
