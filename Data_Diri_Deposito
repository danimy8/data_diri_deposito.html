    <script>
        let uploadedPhotoBase64 = '';
        let isSigned = false;
        
        const API_URL = "https://script.google.com/macros/s/AKfycbwnX680ihHaIcaOvo5Rm6IcBNaWYwAdCUFwhMNmYyrXmQHRNi9knd8GQVlKTgrpH4nKCw/exec";
        async function kirimKeMasterData(data) {
        try {
            await fetch(API_URL, {
                method: "POST",
                body: JSON.stringify({
                    action: "create",
