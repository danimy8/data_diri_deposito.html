            document.getElementById('depositWords').value = n > 0 ? terbilang(n) + ' Rupiah' : '';
        }

        // Tampilkan isian sesuai cara pembayaran bunga
        function togglePayDetail() {
            const checked = document.querySelector('input[name="interestPay"]:checked');
            const m = checked ? checked.value : '';
            const bpr = m === 'Transfer ke tabungan BPR';
            const bank = m === 'Transfer ke Bank lain';
            document.getElementById('payBprBox').classList.toggle('hidden', !bpr);
            document.getElementById('payBankBox').classList.toggle('hidden', !bank);
            ['payBprNo', 'payBprName'].forEach(id => {
                const el = document.getElementById(id);
                el.required = bpr;
                if (!bpr) el.value = '';
            });
            ['payBankName', 'payBankNo', 'payBankOwner'].forEach(id => {
                const el = document.getElementById(id);
                el.required = bank;
                if (!bank) el.value = '';
            });
            if (!bank) document.getElementById('payBankAddress').value = '';
        }

        // Susun teks Pembayaran Bunga untuk review dan Sheet
        function getInterestPayment() {
            const m = document.querySelector('input[name="interestPay"]:checked').value;
            const v = id => document.getElementById(id).value.trim() || '-';
            if (m === 'Tunai') return 'Tunai';
            if (m === 'Transfer ke tabungan BPR') {
                return 'Transfer ke tabungan BPR (No. Rekening: ' + v('payBprNo') + ', a.n. ' + v('payBprName') + ')';
            }
            return 'Transfer ke Bank lain (Bank: ' + v('payBankName') + ', No. Rekening: ' + v('payBankNo') +
                   ', a.n. ' + v('payBankOwner') + ', Alamat: ' + v('payBankAddress') + ')';
        }
        
        async function handleFormSubmit(event) {
            event.preventDefault();

            // Validate Signature
            if (!isSigned) {
                document.getElementById('sigError').classList.remove('hidden');
                canvas.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            // Gather values
            const fullName = document.getElementById('fullName').value;
            const nik = document.getElementById('nik').value;
            const birthPlace = document.getElementById('birthPlace').value;
            const birthDateVal = document.getElementById('birthDate').value;
            const gender = document.getElementById('gender').value;
            const religion = document.getElementById('religion').value;
            const phone = document.getElementById('phone').value;
            const address = document.getElementById('address').value;
            const citizenship    = document.getElementById('citizenship').value;
            const npwp           = document.getElementById('npwp').value.trim() || '-';
            const education      = document.getElementById('education').value;
            const motherName     = document.getElementById('motherName').value;
            const spouseName     = document.getElementById('spouseName').value.trim() || '-';
            const job            = document.getElementById('job').value;
            const jobAddress     = document.getElementById('jobAddress').value;
            const income         = document.getElementById('income').value;
            const turnoverRaw    = document.getElementById('turnover').value;
            const turnover       = turnoverRaw ? 'Rp ' + turnoverRaw : '-';
            const accountPurpose = getSelectOrOther('accountPurpose', 'accountPurposeOther');
            const fundSource     = getSelectOrOther('fundSource', 'fundSourceOther');
            const heirName       = document.getElementById('heirName').value;
            const heirRelation   = document.getElementById('heirRelation').value;
            const heirAddress    = document.getElementById('heirAddress').value;
            const alias          = document.getElementById('alias').value.trim() || '-';  
            const maritalStatus  = document.getElementById('maritalStatus').value;  
            const otherAccount   = document.getElementById('otherAccount').value.trim() || '-';
            const otherAccountNo = document.getElementById('otherAccountNo').value.trim() || '-';
            const depositAmountRaw = document.getElementById('depositAmount').value;
            const depositAmount    = depositAmountRaw ? 'Rp ' + depositAmountRaw : '-';
            const depositWords     = document.getElementById('depositWords').value || '-';
            const depositTerm      = document.querySelector('input[name="depositTerm"]:checked').value;
            const depositRateRaw   = document.getElementById('depositRate').value.trim();
            const depositRate      = depositRateRaw ? depositRateRaw + ' % per Tahun' : '-';
            const depositRoll      = document.getElementById('depositRoll').checked ? 'Otomatis (Automatic Roll Over)' : '-';
            const interestPay      = getInterestPayment();

kirimKeMasterData({
    namaLengkap: fullName,
    nik: nik,
    tempatLahir: birthPlace,
    tanggalLahir: birthDateVal,
    jenisKelamin: gender,
    agama: religion,
    noTelepon: phone,
    alamat: address,
    kewarganegaraan: citizenship,
    npwp: npwp,
    pendidikan: education,
    namaIbuKandung: motherName,
    namaPasangan: spouseName,
    pekerjaan: job,
    alamatPekerjaan: jobAddress,
    penghasilanPerBulan: income,
    omsetPerBulan: turnover,
    tujuanPembukaanRekening: accountPurpose,
    asalSumberDana: fundSource,
    namaAhliWaris: heirName,
    alamatAhliWaris: heirAddress,
    hubunganAhliWaris: heirRelation,
    aliasNama: alias,     
    statusPernikahan: maritalStatus,
    produkDipilih: 'Deposito',
    rekeningLain: otherAccount,
    nomorRekeningLain: otherAccountNo,
    nominalDeposito: depositAmount,
    terbilangDeposito: depositWords,
    jangkaWaktuDeposito: depositTerm,
    sukuBungaDeposito: depositRate,
    perpanjanganDeposito: depositRoll,
    pembayaranBunga: interestPay,
    fotoKtp: await compressImage(uploadedPhotoBase64, 1200),
    tandaTangan: canvas.toDataURL('image/png'),
});
            // Format Birth Date to ID format (e.g. 17 Agustus 1995)
            const formattedDate = new Date(birthDateVal).toLocaleDateString('id-ID', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });

            // Populate Review Card Data
            document.getElementById('reviewName').innerText = fullName;
            document.getElementById('reviewNik').innerText = nik;
            document.getElementById('reviewTtl').innerText = `${birthPlace}, ${formattedDate}`;
            document.getElementById('reviewGender').innerText = gender;
            document.getElementById('reviewReligion').innerText = religion;
            document.getElementById('reviewPhone').innerText = phone;
            document.getElementById('reviewAddress').innerText = address;
            document.getElementById('reviewSignerName').innerText = fullName;
            document.getElementById('reviewCitizenship').innerText = citizenship;
            document.getElementById('reviewNpwp').innerText = npwp;
            document.getElementById('reviewEducation').innerText = education;
            document.getElementById('reviewMother').innerText = motherName;
            document.getElementById('reviewSpouse').innerText = spouseName;
            document.getElementById('reviewJob').innerText = job;
            document.getElementById('reviewJobAddress').innerText = jobAddress;
            document.getElementById('reviewIncome').innerText = income;
            document.getElementById('reviewTurnover').innerText = turnover;
            document.getElementById('reviewPurpose').innerText = accountPurpose;
            document.getElementById('reviewFund').innerText = fundSource;
            document.getElementById('reviewHeirName').innerText = heirName;
            document.getElementById('reviewHeirRelation').innerText = heirRelation;
            document.getElementById('reviewHeirAddress').innerText = heirAddress;
            document.getElementById('reviewAlias').innerText = alias;                
            document.getElementById('reviewMarital').innerText = maritalStatus;
            document.getElementById('reviewSignDate').innerText = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
            document.getElementById('reviewDepositAmount').innerText = depositAmount;
            document.getElementById('reviewDepositWords').innerText = depositWords;
            document.getElementById('reviewDepositTerm').innerText = depositTerm;
            document.getElementById('reviewDepositRate').innerText = depositRate;
            document.getElementById('reviewDepositRoll').innerText = depositRoll;
            document.getElementById('reviewInterestPay').innerText = interestPay;
            document.getElementById('reviewOtherAccount').innerText = otherAccount;
            document.getElementById('reviewOtherAccountNo').innerText = otherAccountNo;


            // Set Photo & Signature Data URL
            document.getElementById('reviewPhoto').src = uploadedPhotoBase64;
            document.getElementById('reviewSignature').src = canvas.toDataURL('image/png');

            // Toggle Visibility
            document.getElementById('formSection').classList.add('hidden');
            document.getElementById('reviewSection').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function editForm() {
            document.getElementById('reviewSection').classList.add('hidden');
            document.getElementById('formSection').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
